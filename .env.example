# 复制本文件为 .env 后填写（.env 已被 .gitignore 忽略，不会进仓库、不会被提交）
#
# —— AI 建议（可选）：不填也能用手动编写规则的完整流程 ——
# 三类前缀都认，按 LLM_ → OPENAI_ → OPENCODE_ 的顺序取第一个非空值，
# 所以直接用各家 SDK 习惯的 OPENAI_* 名字也可以。
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://third-party.example.com/v1
# OPENAI_MODEL=gpt-4o
# 推理模型一次建议可能要几十秒，默认给 180 秒；不够就调大
# LLM_TIMEOUT=300
#
# —— 端口 / 数据库（可选）——
# VERIFIER_DB=verifier_data/verifier.db
# VERIFIER_HOST=127.0.0.1
# VERIFIER_PORT=8622
# DEMO_BASELINE_PORT=8620
# DEMO_CANDIDATE_PORT=8621
# DEMO_DEFECTS=none
